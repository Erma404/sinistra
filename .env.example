# Clé API Anthropic : à définir côté serveur uniquement (Vercel > Settings > Environment Variables).
# Sans clé, la démo fonctionne en mode hors ligne avec l'analyseur à règles (sans IA).
ANTHROPIC_API_KEY=
# Optionnel : modèle utilisé par la fonction serveur (défaut : claude-opus-5-5)
SINISTRA_MODEL=
